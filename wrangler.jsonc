{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "romanroman",
  "main": "worker.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "romanroman-emails",
      "database_id": "51d3af6c-ab72-4a0b-acf0-17065a6162ff"
    }
  ]
}
